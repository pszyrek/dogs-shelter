{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "incremental": true,
    "isolatedModules": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@DSB/*": ["apps/dogs-shelter-backend/*"],
      "@DSF/*": ["apps/dogs-shelter-frontend/*"],
      "@DSUI/*": ["packages/ui/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
