{
  "extends": "@dogs-shelter/typescript-config/nextjs.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": {
      "@DSB/*": ["../dogs-shelter-backend/src/*"],
      "@DSF/*": ["./*"],
      "@DSUI/*": ["../../packages/ui/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
