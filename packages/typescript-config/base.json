{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@DSB/*": ["../../apps/dogs-shelter-backend/src/*"],
      "@DSF/*": ["../../apps/dogs-shelter-frontend/*"],
      "@DSUI/*": ["../../packages/ui/*"]
    }
  }
}
